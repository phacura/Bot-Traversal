+            {
+            probe.NativeStrategySelected=true;probe.AssistedStrategySelected=false;
+            var edge=LearnedTraversalEdges.FirstOrDefault(x=>x!=null&&x.Id==(c.SkillTransferTransient?c.SkillTemplateEdgeId:c.EdgeId));
